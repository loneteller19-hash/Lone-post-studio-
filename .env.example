PORT=3000
# Used for Google sign-in redirect. localhost is fine on the same phone.
BASE_URL=http://localhost:3000
# Public https URL Instagram can download videos from (e.g. the cloudflared tunnel URL). Needed only for Instagram.
PUBLIC_URL=
# Google Cloud: OAuth client (Web), enable YouTube Data API v3,
# redirect URI = BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta: Instagram Business/Creator account + long-lived token (instagram_content_publish)
IG_USER_ID=
IG_ACCESS_TOKEN=
